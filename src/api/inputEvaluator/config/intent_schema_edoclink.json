{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoclink.local/schemas/intent-router/1.0.json",
  "title": "edoclink Intent Router Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "language",
    "status",
    "intent",
    "target",
    "entities",
    "filters",
    "missing_slots",
    "clarification",
    "reason_code",
    "suspected_prompt_injection"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "catalog_version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "language": { "type": "string", "enum": ["pt-PT", "pt", "en", "es", "fr", "de", "ar", "unknown"] },
    "status": { "type": "string", "enum": ["READY", "NEEDS_CLARIFICATION", "OUT_OF_SCOPE", "NO_ACTION"] },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "NO_ACTION",
            "HELP",
            "CANCEL_CURRENT_OPERATION",
            "CONFIRM_PENDING_ACTION",
            "REJECT_PENDING_ACTION",
            "OPEN_DOCUMENT",
            "OPEN_FOLDER",
            "OPEN_FLOW",
            "OPEN_TASK",
            "SEARCH_GLOBAL",
            "SEARCH_DOCUMENTS",
            "SEARCH_FOLDERS",
            "SEARCH_FLOWS",
            "SEARCH_TASKS",
            "LIST_ATTACHMENTS",
            "VIEW_HISTORY",
            "VIEW_VERSIONS",
            "VIEW_RELATED_OBJECTS",
            "READ_VISIBLE_CONTENT",
            "CONTROL_READING",
            "SUMMARIZE_DOCUMENT",
            "ASK_DOCUMENT",
            "CREATE_DOCUMENT_DRAFT",
            "CREATE_FOLDER_DRAFT",
            "SET_FIELD_VALUE",
            "CLASSIFY_OBJECT",
            "SAVE_DRAFT",
            "RESUME_DRAFT",
            "PREPARE_FLOW_ACTION",
            "OUT_OF_SCOPE"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "reference", "name"],
      "properties": {
        "object_type": { "type": "string", "enum": ["document", "folder", "flow", "task", "file", "draft", "current_view", "none"] },
        "reference": { "type": ["string", "null"], "maxLength": 200 },
        "name": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "raw_value", "normalized_value", "source", "confidence"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "document_reference", "folder_reference", "flow_reference", "task_reference",
              "title", "document_type", "classification", "entity", "date", "date_range",
              "status", "owner", "stage", "field_name", "field_value", "flow_action",
              "reading_control", "sort", "limit", "free_text"
            ]
          },
          "raw_value": { "type": "string", "maxLength": 1000 },
          "normalized_value": { "type": ["string", "number", "boolean", "null"], "maxLength": 1000 },
          "source": { "type": "string", "enum": ["utterance", "selected_context", "pending_action_context"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "type": "string", "maxLength": 100 },
          "operator": { "type": "string", "enum": ["eq", "neq", "contains", "starts_with", "before", "after", "between", "in"] },
          "value": {
            "oneOf": [
              { "type": "string", "maxLength": 1000 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "maxItems": 50, "items": { "type": ["string", "number", "boolean"] } }
            ]
          }
        }
      }
    },
    "missing_slots": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 100 }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": { "type": ["string", "null"], "maxLength": 500 },
        "options": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "EXPLICIT_COMMAND", "CONTEXTUAL_COMMAND", "AMBIGUOUS_INTENT", "MISSING_REQUIRED_SLOT",
        "MULTIPLE_INDEPENDENT_ACTIONS", "UNSUPPORTED_OPERATION", "CONVERSATIONAL_ONLY",
        "PENDING_CONFIRMATION", "PENDING_CANCELLATION", "POSSIBLE_INSTRUCTION_INJECTION"
      ]
    },
    "suspected_prompt_injection": { "type": "boolean" }
  }
}
